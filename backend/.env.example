# Client Credentials Grant — from a Custom App in the Box developer console
# (auth method: "Server Authentication (Client Credentials Grant)"),
# authorized by an enterprise admin in the Admin Console.
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Which identity CCG acts as — set one:
# BOX_USER_ID acts as your own Box account (inherits your existing folder
# access; the app needs the "Generate User Access Tokens" scope approved).
# BOX_ENTERPRISE_ID acts as the enterprise's Service Account instead, which
# starts with no folder access until you collaborate it into the portal root.
BOX_USER_ID=
BOX_ENTERPRISE_ID=

BOX_PORTAL_ROOT_FOLDER_ID=418113709484
